#!/bin/bash
#PBS -N sdxl_safemt
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe

export PIP_CACHE_DIR=${TMPDIR:-/tmp}/safemt-pip-cache
export HF_HOME=${TMPDIR:-/tmp}/safemt-hf-cache

cd "${SAFEMT_WORK_DIR:-${PBS_O_WORKDIR:-$PWD}}"

module load cuda/12.1.1
module load python/3.10.8
if [ -n "${SAFEMT_VENV:-}" ]; then source "${SAFEMT_VENV}/bin/activate"; fi

python3 hpc_generate_sdxl.py \
    --jobs hpc_sdxl_jobs.json \
    --output-dir ./output \
    --start 0 --end 1350
